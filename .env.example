# Postgres from docker-compose.yml (npm run db:up)
DATABASE_URL="postgresql://mandala:mandala@localhost:5434/mandala?schema=public"
# Unpooled URL for migrations. Locally it's the same DB; Neon on Vercel sets this automatically.
DATABASE_URL_UNPOOLED="postgresql://mandala:mandala@localhost:5434/mandala?schema=public"

# NextAuth — generate a secret with: npx auth secret  (or: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
