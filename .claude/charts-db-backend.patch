diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index f19637f..daa55ae 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -29,6 +29,67 @@ model User {
 
   accounts Account[]
   sessions Session[]
+  charts   Chart[]
+}
+
+enum ActionStatus {
+  EMPTY
+  PENDING
+  DONE
+}
+
+// One Mandala Chart: a main goal, 8 sub-goals, 8 actions each.
+model Chart {
+  id           String    @id @default(cuid())
+  ownerId      String
+  title        String
+  category     String?
+  // Public charts can be viewed at /p/[id] and copied by other users.
+  isPublic     Boolean   @default(false)
+  publishedAt  DateTime?
+  // Set when this chart was copied from someone else's public chart.
+  copiedFromId String?
+  copyCount    Int       @default(0)
+  createdAt    DateTime  @default(now())
+  updatedAt    DateTime  @updatedAt
+
+  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
+  copiedFrom Chart?    @relation("ChartCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
+  copies     Chart[]   @relation("ChartCopies")
+  subgoals   Subgoal[]
+
+  @@index([ownerId])
+  @@index([isPublic, publishedAt])
+}
+
+model Subgoal {
+  id        String  @id @default(cuid())
+  chartId   String
+  position  Int // 0–7, reading order around the core cell
+  title     String
+  // Hint dot 1 ("วิธีผ่าน") and dot 3 ("ถ้าติดอยู่"); dot 2 is derived from actions.
+  passHint  String?
+  stuckHint String?
+
+  chart   Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)
+  actions Action[]
+
+  @@unique([chartId, position])
+}
+
+model Action {
+  id        String       @id @default(cuid())
+  subgoalId String
+  position  Int // 0–7
+  label     String       @default("")
+  status    ActionStatus @default(EMPTY)
+  note      String       @default("")
+  // [{ id, text, done }] — small checklist inside one action
+  subtasks  Json         @default("[]")
+
+  subgoal Subgoal @relation(fields: [subgoalId], references: [id], onDelete: Cascade)
+
