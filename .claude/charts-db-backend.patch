@@ -0,0 +1,38 @@
+'use client';
+
+import { useState, useTransition } from 'react';
+import { CopyPlus, Loader2 } from 'lucide-react';
+import { copyPublicChart } from '@/app/actions/charts';
+
+export default function CopyChartButton({ chartId, className = '' }) {
+  const [pending, startTransition] = useTransition();
+  const [error, setError] = useState('');
+
+  function copy() {
+    setError('');
+    startTransition(async () => {
+      try {
+        // Redirects to the new copy on success.
+        await copyPublicChart(chartId);
+      } catch (e) {
+        if (e?.digest?.startsWith('NEXT_REDIRECT')) throw e;
+        setError('คัดลอกไม่สำเร็จ — Chart นี้อาจถูกปิดสาธารณะไปแล้ว');
+      }
+    });
+  }
+
+  return (
+    <div className={'flex flex-col gap-1.5 ' + className}>
+      <button
+        type="button"
+        onClick={copy}
+        disabled={pending}
+        className="tap flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-coral shadow-coral text-white disabled:opacity-70"
+      >
+        {pending ? <Loader2 size={16} className="animate-spin" /> : <CopyPlus size={16} />}
+        <span className="font-display font-semibold text-sm">ใช้ Chart นี้</span>
+      </button>
+      {error && <p role="alert" className="text-[12px] font-semibold text-red-600">{error}</p>}
+    </div>
+  );
+}
