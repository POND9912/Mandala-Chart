+'use server';
+
+import { redirect } from 'next/navigation';
+import { revalidatePath } from 'next/cache';
+import { prisma } from '@/lib/prisma';
+import { getSession } from '@/lib/auth';
+import { chartCreateData, SLOTS } from '@/lib/charts';
+
+async function requireUserId() {
+  const session = await getSession();
+  if (!session?.user?.id) throw new Error('ต้องเข้าสู่ระบบก่อน');
+  return session.user.id;
+}
+
+const clean = (v, max) => String(v ?? '').trim().slice(0, max);
+
+export async function createChart({ title, category, subgoalTitles }) {
+  const userId = await requireUserId();
+  const t = clean(title, 200);
+  if (!t) throw new Error('กรุณาใส่เป้าหมายหลัก');
+  const titles = Array.from({ length: SLOTS }, (_, i) => clean(subgoalTitles?.[i], 120) || `หัวข้อย่อยที่ ${i + 1}`);
+
+  const chart = await prisma.chart.create({
+    data: chartCreateData({ ownerId: userId, title: t, category: clean(category, 60), subgoals: titles.map((title) => ({ title })) }),
+    select: { id: true },
+  });
+  redirect(`/chart/${chart.id}`);
+}
+
+export async function setChartPublic(chartId, isPublic) {
+  const userId = await requireUserId();
+  const { count } = await prisma.chart.updateMany({
+    where: { id: chartId, ownerId: userId },
+    data: { isPublic: Boolean(isPublic), publishedAt: isPublic ? new Date() : null },
+  });
+  if (count === 0) throw new Error('ไม่พบ Chart นี้');
+  revalidatePath(`/chart/${chartId}`);
+  revalidatePath('/templates');
+  return { isPublic: Boolean(isPublic) };
+}
+
+// Copies someone's public chart into the signed-in user's account as a fresh
+// start: same goal, sub-goals, actions and hints — but no progress, notes or
+// ticked sub-steps from the original owner.
+export async function copyPublicChart(chartId) {
+  const userId = await requireUserId();
+  const source = await prisma.chart.findFirst({
+    where: { id: chartId, isPublic: true },
+    include: { subgoals: { orderBy: { position: 'asc' }, include: { actions: { orderBy: { position: 'asc' } } } } },
+  });
+  if (!source) throw new Error('Chart นี้ไม่ได้เปิดเป็นสาธารณะแล้ว');
+
+  const copy = await prisma.$transaction(async (tx) => {
+    const created = await tx.chart.create({
+      data: chartCreateData({
+        ownerId: userId,
+        title: source.title,
+        category: source.category,
+        copiedFromId: source.id,
+        subgoals: source.subgoals.map((s) => ({
+          title: s.title,
+          passHint: s.passHint,
+          stuckHint: s.stuckHint,
+          actions: s.actions.map((a) => ({
+            label: a.label,
+            subtasks: (Array.isArray(a.subtasks) ? a.subtasks : []).map((st) => ({ ...st, done: false })),
+          })),
+        })),
+      }),
+      select: { id: true },
+    });
+    // Copying your own chart is allowed but shouldn't inflate its popularity.
+    if (source.ownerId !== userId) {
+      await tx.chart.update({ where: { id: source.id }, data: { copyCount: { increment: 1 } } });
+    }
+    return created;
+  });
+
+  revalidatePath('/gallery');
+  redirect(`/chart/${copy.id}`);
+}
+
+// Saves one action cell. Ownership is checked through subgoal → chart.
+export async function saveAction(actionId, patch) {
+  const userId = await requireUserId();
+  const action = await prisma.action.findFirst({
+    where: { id: actionId, subgoal: { chart: { ownerId: userId } } },
+    select: { id: true, subgoal: { select: { chartId: true } } },
+  });
+  if (!action) throw new Error('ไม่พบ action นี้');
+
+  const data = {};
+  if ('label' in patch) data.label = clean(patch.label, 300);
+  if ('note' in patch) data.note = clean(patch.note, 2000);
+  if ('status' in patch && ['empty', 'pending', 'done'].includes(patch.status)) data.status = patch.status.toUpperCase();
+  if ('subtasks' in patch && Array.isArray(patch.subtasks)) {
+    data.subtasks = patch.subtasks.slice(0, 30).map((s) => ({ id: String(s.id), text: clean(s.text, 200), done: Boolean(s.done) }));
+  }
+
+  await prisma.$transaction([
+    prisma.action.update({ where: { id: actionId }, data }),
+    // Touch the chart so "อัปเดตล่าสุด" and reminder weighting reflect activity.
+    prisma.chart.update({ where: { id: action.subgoal.chartId }, data: { updatedAt: new Date() } }),
+  ]);
+  // Drop cached renders (incl. the client router cache) so % is fresh on the way back.
+  revalidatePath(`/chart/${action.subgoal.chartId}`, 'layout');
+  revalidatePath('/gallery');
+}
