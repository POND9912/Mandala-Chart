--- /dev/null
+++ b/lib/charts.js
@@ -0,0 +1,206 @@
+import 'server-only';
+import { prisma } from '@/lib/prisma';
+
+// Server-side data access for Mandala Charts. Every read here returns plain
+// objects shaped for the UI (percent, hints, lowercase statuses) so pages
+// don't deal with Prisma rows directly.
+
+export const SLOTS = 8;
+
+const FULL_INCLUDE = {
+  subgoals: {
+    orderBy: { position: 'asc' },
+    include: { actions: { orderBy: { position: 'asc' } } },
+  },
+};
+
+function percentOf(actions) {
+  const done = actions.filter((a) => a.status === 'DONE').length;
+  return Math.round((done / SLOTS) * 100);
+}
+
+function chartPercent(subgoals) {
+  if (subgoals.length === 0) return 0;
+  const total = subgoals.reduce((sum, s) => sum + percentOf(s.actions), 0);
+  return Math.round(total / subgoals.length);
+}
+
+function nextStepHint(actions) {
+  const next = actions.find((a) => a.status === 'pending');
+  if (next) return next.label;
+  if (actions.some((a) => a.status === 'empty')) return 'ยังไม่มี action ที่รออยู่ — เพิ่ม action ใหม่ 1 ข้อ';
+  return 'ทำ action ครบแล้ว! ไปทำตามเงื่อนไขวิธีผ่านได้เลย';
+}
+
+// "2 ชม.ที่แล้ว" style label for the gallery cards.
+export function timeAgo(date) {
+  const mins = Math.floor((Date.now() - new Date(date).getTime()) / 60000);
+  if (mins < 1) return 'เมื่อสักครู่';
+  if (mins < 60) return `${mins} นาทีที่แล้ว`;
+  const hours = Math.floor(mins / 60);
+  if (hours < 24) return `${hours} ชม.ที่แล้ว`;
+  const days = Math.floor(hours / 24);
+  if (days === 1) return 'เมื่อวาน';
+  if (days < 7) return `${days} วันก่อน`;
+  if (days < 30) return `${Math.floor(days / 7)} สัปดาห์ก่อน`;
+  return `${Math.floor(days / 30)} เดือนก่อน`;
+}
+
+function shapeAction(a) {
+  return {
+    id: a.id,
+    label: a.label,
+    status: a.status.toLowerCase(),
+    note: a.note,
+    subtasks: Array.isArray(a.subtasks) ? a.subtasks : [],
+  };
+}
+
+// Full chart for its owner — everything, including hints and progress.
+function shapeOwnerChart(chart) {
+  const percent = chartPercent(chart.subgoals);
+  return {
+    id: chart.id,
+    title: chart.title,
+    category: chart.category,
+    isPublic: chart.isPublic,
+    copyCount: chart.copyCount,
+    percent,
+    status: percent === 100 ? 'done' : 'active',
+    updatedAt: chart.updatedAt.toISOString(),
+    subgoals: chart.subgoals.map((s) => {
+      const actions = s.actions.map(shapeAction);
+      return {
+        id: s.id,
+        num: s.position + 1,
+        title: s.title,
+        percent: percentOf(s.actions),
+        actions,
+        // One hint per dot: when it's done → what to do next → what to do when stuck.
+        hints: [
+          s.passHint ? { label: 'วิธีผ่าน', text: s.passHint } : null,
+          { label: 'ก้าวถัดไป', text: nextStepHint(actions) },
+          s.stuckHint ? { label: 'ถ้าติดอยู่', text: s.stuckHint } : null,
+        ],
+      };
+    }),
+  };
+}
+
+export async function getUserCharts(userId) {
+  const charts = await prisma.chart.findMany({
+    where: { ownerId: userId },
+    orderBy: { updatedAt: 'desc' },
+    include: FULL_INCLUDE,
+  });
+  return charts.map(shapeOwnerChart);
+}
+
+// Returns null when the chart doesn't exist or isn't owned by this user,
+// so callers can 404 without leaking whether the id exists.
+export async function getOwnedChart(chartId, userId) {
+  const chart = await prisma.chart.findFirst({ where: { id: chartId, ownerId: userId }, include: FULL_INCLUDE });
+  return chart ? shapeOwnerChart(chart) : null;
+}
+
+// What other people see on /p/[id]: structure + the owner's percentages only.
+// Deliberately omits action statuses, notes, subtasks and the paid "ถ้าติดอยู่" hint.
+export async function getPublicChart(chartId) {
+  const chart = await prisma.chart.findFirst({
+    where: { id: chartId, isPublic: true },
+    include: { ...FULL_INCLUDE, owner: { select: { name: true } } },
+  });
+  if (!chart) return null;
+  return {
+    id: chart.id,
+    ownerId: chart.ownerId,
+    ownerName: chart.owner.name || 'ผู้ใช้ Mandala AI',
+    title: chart.title,
+    category: chart.category,
+    copyCount: chart.copyCount,
+    publishedAt: chart.publishedAt?.toISOString() ?? null,
+    percent: chartPercent(chart.subgoals),
+    subgoals: chart.subgoals.map((s) => ({
+      id: s.id,
+      title: s.title,
+      percent: percentOf(s.actions),
+      passHint: s.passHint,
+      actions: s.actions.filter((a) => a.label).map((a) => ({ id: a.id, label: a.label })),
+    })),
+  };
+}
+
+export async function listPublicCharts({ take = 60 } = {}) {
+  const charts = await prisma.chart.findMany({
+    where: { isPublic: true },
+    orderBy: [{ copyCount: 'desc' }, { publishedAt: 'desc' }],
+    take,
+    include: { ...FULL_INCLUDE, owner: { select: { name: true } } },
+  });
+  return charts.map((c) => ({
+    id: c.id,
+    ownerId: c.ownerId,
+    ownerName: c.owner.name || 'ผู้ใช้ Mandala AI',
+    title: c.title,
+    category: c.category,
+    copyCount: c.copyCount,
+    percent: chartPercent(c.subgoals),
+    subgoalTitles: c.subgoals.map((s) => s.title),
+  }));
+}
+
+// Everything the reminder bell may pick from: unfinished actions in unfinished
+// charts, weighted by how recently the chart was touched.
+export function dailyActionCandidates(charts) {
+  return charts
+    .filter((c) => c.status === 'active')
+    .flatMap((chart) => {
+      const days = (Date.now() - new Date(chart.updatedAt).getTime()) / 86400000;
+      const weight = days < 1 ? 3 : days < 3 ? 2 : 1;
+      return chart.subgoals.flatMap((s) =>
+        s.actions
+          .filter((a) => a.label && a.status !== 'done')
+          .map((a) => ({
+            id: a.id,
+            label: a.label,
+            chartId: chart.id,
+            chartTitle: chart.title,
+            subgoalId: s.id,
+            subgoalTitle: s.title,
+            weight,
+          }))
+      );
+    });
+}
+
+// Nested create payload for a chart with 8 sub-goals × 8 actions.
+// `subgoals` items: { title, passHint?, stuckHint?, actions?: [{ label, status?, note?, subtasks? }] }
+export function chartCreateData({ ownerId, title, category, subgoals, copiedFromId }) {
+  return {
+    ownerId,
+    title,
+    category: category || null,
+    copiedFromId: copiedFromId || null,
+    subgoals: {
+      create: subgoals.slice(0, SLOTS).map((s, position) => ({
+        position,
+        title: s.title,
+        passHint: s.passHint || null,
+        stuckHint: s.stuckHint || null,
+        actions: {
+          create: Array.from({ length: SLOTS }, (_, i) => {
+            const a = s.actions?.[i] || {};
+            const label = (a.label || '').trim();
+            return {
+              position: i,
+              label,
+              status: label ? a.status || 'PENDING' : 'EMPTY',
+              note: a.note || '',
+              subtasks: a.subtasks || [],
+            };
+          }),
+        },
+      })),
+    },
+  };
+}
