+// Sample Mandala Charts used by the seed so a fresh database has something to
+// look at (and one public chart for the templates page).
+//
+// Each sub-goal: { title, passHint?, stuckHint?, done, labels? }
+//  - `done`   how many of the 8 actions start ticked (drives the % shown)
+//  - `labels` explicit action labels; otherwise generic ones are generated
+
+const SLOTS = 8;
+
+function actions({ done, labels }) {
+  const filled = Math.max(labels?.length || 0, Math.min(SLOTS, done + 2));
+  return Array.from({ length: SLOTS }, (_, i) => {
+    const label = labels?.[i] || (i < filled ? `แผนปฏิบัติข้อที่ ${i + 1}` : '');
+    return { label, status: !label ? 'EMPTY' : i < done ? 'DONE' : 'PENDING' };
+  });
+}
+
