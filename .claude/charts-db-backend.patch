+    [2, 1, 2, 3, 1, 0, 2, 1]
+  ),
+  simple(
+    'อ่านหนังสือ 24 เล่ม',
+    'การเรียนรู้',
+    ['นิยาย', 'ธุรกิจ', 'จิตวิทยา', 'ประวัติศาสตร์', 'วิทยาศาสตร์', 'พัฒนาตัวเอง', 'ภาษาอังกฤษ', 'ชมรมหนังสือ'],
+    [6, 7, 5, 6, 6, 7, 5, 6]
+  ),
+  simple(
+    'เรียนภาษาญี่ปุ่นเบื้องต้น',
